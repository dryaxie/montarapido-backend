# ══════════════════════════════════════════════════════════
#  MONTARAPIDO — Variáveis de Ambiente para Docker
#  Copie este arquivo para .env antes de rodar o compose
#  cp .env.docker .env
# ══════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=montarapido_db
POSTGRES_USER=montarapido
POSTGRES_PASSWORD=Monta@2025#Seguro!

# ── JWT (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=COLE_AQUI_UMA_CHAVE_HEX_DE_128_CARACTERES
JWT_REFRESH_SECRET=COLE_AQUI_OUTRA_CHAVE_HEX_DE_128_CARACTERES

# ── URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api

# ── Mercado Pago ───────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SUA_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=APP_USR-SUA_PUBLIC_KEY

# ── WhatsApp (Z-API) ───────────────────────────────────────
WHATSAPP_API_URL=https://api.z-api.io/instances/SEU_INSTANCE/token/SEU_TOKEN
WHATSAPP_TOKEN=SEU_CLIENT_TOKEN
ADMIN_WHATSAPP=5511999999999

# ── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_gmail
EMAIL_FROM=MontaRapido <noreply@montarapido.com.br>
