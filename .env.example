# ─── SERVIDOR ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ─── BANCO DE DADOS (PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/montarapido_db?schema=public"

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=sua_chave_secreta_super_segura_aqui_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=outra_chave_refresh_super_segura_aqui
JWT_REFRESH_EXPIRES_IN=30d

# ─── MERCADO PAGO ────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret

# ─── WHATSAPP (via Z-API ou Evolution API) ───────────────
WHATSAPP_API_URL=https://api.z-api.io/instances/SEU_INSTANCE/token/SEU_TOKEN
WHATSAPP_TOKEN=seu_token_zapi
WHATSAPP_INSTANCE_ID=seu_instance_id
# Número WhatsApp do Admin Geral
ADMIN_WHATSAPP=5511999999999

# ─── EMAIL (Nodemailer / Gmail / SMTP) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_gmail
EMAIL_FROM=MontaRapido <noreply@montarapido.com.br>

# ─── UPLOAD DE ARQUIVOS ──────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── CONFIGURAÇÕES DO NEGÓCIO ────────────────────────────
# Porcentagem que vai para o montador (padrão: 50%)
MONTADOR_COMMISSION_PERCENT=50
# Porcentagem da plataforma (padrão: 50%)
PLATFORM_FEE_PERCENT=50
# Prazo máximo para montador aceitar serviço (horas)
JOB_ACCEPT_TIMEOUT_HOURS=2
