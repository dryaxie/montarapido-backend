{
  "version": 2,
  "builds": [
    {
      "src": "frontend/montarapido.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/api.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api.js",
      "dest": "/frontend/api.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/montarapido.html"
    }
  ]
}
